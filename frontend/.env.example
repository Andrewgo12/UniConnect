# UniConnect — Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commitees .env, .env.local, .env.development ni .env.production.

# Número de emergencia al que llamar cuando se activa el botón EMERGENCIA
# Ejemplo: número de la línea de emergencias de Colombia
NEXT_PUBLIC_EMERGENCY_NUMBER=123

# URL del backend WebSocket (cuando se implemente comunicación real)
# NEXT_PUBLIC_WS_URL=wss://tu-backend.com/ws

# Entorno (development | production)
# NODE_ENV se setea automáticamente por Next.js — no hace falta definirlo aquí
